# MilkWise SG — environment variables
#
# Copy this file to `.env.local` (which is git-ignored) and fill in real
# values. Anything prefixed with EXPO_PUBLIC_ is shipped to the client
# bundle — never put secrets here. Server-only secrets go in a separate
# `.env.server` consumed by the admin/edge-function builds in Session 3.

# Supabase project URL — find under Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key — safe to expose because RLS policies
# in the database enforce row-level access.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build channel — controls which feature flags fire.
# Allowed values: development | preview | production
EXPO_PUBLIC_CHANNEL=development
